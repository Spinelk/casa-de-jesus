---
import Layout from "../layouts/Layout.astro";
import Mapa from "../components/Mapa.astro";

import Banner from "../components/Banner.astro";
---

<Layout titulo="Contacto" descripcion="Contacta con nosotros">
    <Banner titulo="Contacto" imagen="Contacto.jpg" alt="Contacto">
        A través de nuestras redes sociales o en nuestra casa de Talagante.
        <br />
        -Correo: ctcasadejesus@gmail.com
        <br />
        -Telefono: (2) 2683 2719
        <br />
        <p>
            -Facebook: <a
                href="https://web.facebook.com/fundacioneiglesiacasadejesus/?_rdc=1&_rdr"
                >Fundación e Iglesia "Casa de Jesús"</a
            >
        </p>
        <br />
        <p>
            -Instagram: <a href="https://www.instagram.com/casadejesusoficial/"
                >@casadejesusoficial</a
            >
        </p>
    </Banner>
    <Mapa
        titulo="Casa de Jesús Talagante"
        mapURL="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3321.2651064573997!2d-70.88782262430075!3d-33.65029207331107!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662e17364112a05%3A0x4a847c9e9a1ef290!2sCam.%20El%20Oliveto%20200%2C%20Talagante%2C%20Regi%C3%B3n%20Metropolitana!5e0!3m2!1ses!2scl!4v1708137190908!5m2!1ses!2scl"
        alt="Mapa de Talagante"
    >
        Ubicación La casa de Jesús junto con la Iglesia y la casa de adulto
        mayor de Talagante.
        <p>oliveto 200,Talagante. Santiago</p>
    </Mapa>
</Layout>

<style>
    a.active {
        border-bottom: 3px solid var(--azul-milagro);
    }

    a:hover {
        border-bottom: 3px solid var(--azul-milagro);
    }
</style>
