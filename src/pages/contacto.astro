        <Banner titulo="Contacto" imagen="Contacto.jpg" alt="Contacto" tamañoTitulo="text-5xl" header="true">
            Si buscas más información sobre nuestro trabajo o deseas contactarnos, aquí encontrarás toda la información
            que necesitas. También puedes visitarnos en nuestros hogares en Santiago, la Región del Bio Bio y la Región
            de Coquimbo.
        </Banner>

        <!--  -->

        <Informacion />

        <!--  -->

        <div class="py-2 lg:py-4 bg-blue-100"></div>
        <Hogar
            titulo="Casa de Jesús Talagante"
