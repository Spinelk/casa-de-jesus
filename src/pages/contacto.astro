---
import Layout from "../layouts/Layout.astro";

import Banner from "../components/Banner.astro";

import Informacion from "../components/ContactoComponentes/Informacion.astro";
import Hogar from "../components/ContactoComponentes/Hogar.astro";

import { TELEFONO_CONTACTO } from "../consts";
import { ENLACE_INSTAGRAM } from "../consts";
