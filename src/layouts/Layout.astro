---
import BaseHead from "./BaseHead.astro";
import Navbar from "../components/Navbar-Footer/Navbar/Navbar.astro";
import Footer from "../components/Navbar-Footer/Footer.astro";

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead titulo={titulo} descripcion={descripcion} />
    </head>
    <body>
        <Navbar />
        <main class="mt-16 md:mt-[88px] lg:mt-36">
            <slot />
        </main>
        <Footer />

        <script
            is:inline
            src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.8.0/flowbite.min.js"
        ></script>
    </body>
</html>
