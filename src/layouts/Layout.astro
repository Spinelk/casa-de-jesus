---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead titulo={titulo} descripcion={descripcion} />
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
    </body>
</html>
