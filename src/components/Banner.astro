---
const {
    titulo,
    imagen,
    alt,
    tamañoTitulo = "text-4xl",
    tamañoTexto = "text-lg",
} = Astro.props;

const tituloClases = tamañoTitulo;
const textoClases = tamañoTexto;
---
<style>
    section {
        /* background-image = url(${imagen}); */
    }
</style>

<section
    class="w-full aspect-[2/3] sm:aspect-[2/1] md:aspect-[5/2] lg:aspect-[4/1] relative"
>
    <img
        src={imagen}
        class="w-full h-full object-cover absolute brightness-[55%]"
        alt={alt}
    />
    <div
        class={`${textoClases} absolute flex flex-col justify-center items-center w-full h-full font-poppins font-medium text-white`}
    >
        <div
            class="flex flex-col justify-center items-center max-w-5xl px-6 text-center"
        >
            <h1 class={`${tituloClases} font-bold mb-5`}>{titulo}</h1>
            <p>
                <slot />
            </p>
        </div>
    </div>
</section>
