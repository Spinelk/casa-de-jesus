---
const {
    titulo,
    imagen,

    header = false,

    tamañoTitulo = "text-4xl",
    tamañoTexto = "text-lg",
} = Astro.props;

const tituloClases = tamañoTitulo;
const textoClases = tamañoTexto;

---

<section
    class="w-full relative"
>
    <img
        src={imagen}
        class="w-full h-full object-cover absolute brightness-50"
        alt="Imagen Banner"
    />
    <div
        class="relative flex flex-col py-8 lg:min-h-80 justify-center items-center w-full h-full font-poppins font-medium text-white"
    >
        <div
            class="flex flex-col justify-center max-w-6xl px-4 sm:px-6 xl:px-0 lg:text-center"
        >
            {
                header && (
                    <h1 class={`${tituloClases} font-bold mb-5`}>{titulo}</h1>
                )
            }
            {
                !header && (
                    <h2 class={`${tituloClases} font-bold mb-5`}>{titulo}</h2>
                )
            }
            <p class={`${textoClases}`}>
                <slot />
            </p>
        </div>
    </div>
</section>
