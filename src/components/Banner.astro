---
const { titulo, imagen, alt } = Astro.props;
---

<div
    class="w-full aspect-[5/6] sm:aspect-[2/1] md:aspect-[5/2] lg:aspect-[4/1] relative"
>
    <img
        src={imagen}
        class="w-full h-full object-cover absolute brightness-[55%]"
        alt={alt}
    />
    <div
        class="absolute flex flex-col justify-center items-center w-full h-full font-poppins font-medium text-lg sm:text-xl text-white"
    >
        <div
            class="flex flex-col justify-center items-center max-w-5xl px-6 text-center"
        >
            <h1 class="text-4xl sm:text-6xl font-bold mb-5">{titulo}</h1>
            <p>
                <slot />
            </p>
        </div>
    </div>
</div>
