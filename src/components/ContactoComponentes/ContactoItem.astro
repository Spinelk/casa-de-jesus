---
const { colorBg, colorText, hoverColorText, colorBorder, groupHoverColorBg, href } = Astro.props;
---

<div
    class={`flex flex-col justify-center h-40 ${colorBg} text-white p-2 border-4 ${colorBorder} group transition-all hover:bg-white ${hoverColorText} hover:cursor-pointer`}
>
    <a href={href} target="_blank">
        <div class="grid grid-rows-2 gap-2">
            <div class="flex justify-center items-end">
                <div
                    class={`bg-white rounded-full h-12 w-12 aspect-square flex items-center justify-center transition-all ${groupHoverColorBg}`}
                >
                    <svg
                        class={`w-7 h-7 ${colorText} transition-all group-hover:text-white`}
                        aria-hidden="true"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <slot name="icono" />
                    </svg>
                </div>
            </div>
            <div>
                <slot class="text-white" name="texto" />
            </div>
        </div>
    </a>
</div>
