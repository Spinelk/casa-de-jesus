---
import HeaderLink from "./HeaderLink.astro";
import Swiper from 'swiper';
import 'swiper/swiper-bundle.css';
---

<header>

    <nav>
        <div class="Navbar_Brand">
            <!-- <h2><a href="/">{SITE_TITLE}</a></h2> -->
            <img src="logo.webp" alt="" style="aspect-ratio: 1; width: 50px;" />
        </div>
        <div class="Navbar_Toggle">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                x="0px"
                y="0px"
                width="50"
                height="50"
                viewBox="0 0 72 72"
            >
                <path
                    d="M56 48c2.209 0 4 1.791 4 4 0 2.209-1.791 4-4 4-1.202 0-38.798 0-40 0-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4C17.202 48 54.798 48 56 48zM56 32c2.209 0 4 1.791 4 4 0 2.209-1.791 4-4 4-1.202 0-38.798 0-40 0-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4C17.202 32 54.798 32 56 32zM56 16c2.209 0 4 1.791 4 4 0 2.209-1.791 4-4 4-1.202 0-38.798 0-40 0-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4C17.202 16 54.798 16 56 16z"
                ></path>
            </svg>
        </div>
        <div class="Navbar_Items">
            <div class="Internal_Links">
                <HeaderLink href="/">Inicio</HeaderLink>
                <HeaderLink href="/nosotros">Sobre Nosotros</HeaderLink>
                <HeaderLink href="/ayuda">¿Necesitas Ayuda?</HeaderLink>
                <HeaderLink href="#">Contacto</HeaderLink>
                <HeaderLink href="#">Galeria</HeaderLink>
                <!-- <HeaderLink href="/blog">Blog</HeaderLink> -->
            </div>
        </div>
    </nav>
    <div class="swiper-container">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="single-slide" style="background-image: url('public/blog-placeholder-1.jpg');">
              <!-- Aquí va el contenido de tu slide -->
              <h1>holaholahola</h1>
            </div>
          </div>
          <div class="swiper-slide">
            <div class="single-slide" style="background-image: url('img/slider/slider2.jpg');">
              <!-- Aquí va el contenido de tu slide -->
            </div>
          </div>
          <!-- Agrega más slides según sea necesario -->
        </div>
        <!-- Add Pagination -->
        <div class="swiper-pagination"></div>
        <!-- Add Navigation -->
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>
</header>
<script>
    function classToggle() {
        const navs = document.querySelectorAll(".Navbar_Items");

        navs.forEach((nav) => nav.classList.toggle("Navbar_ToggleShow"));
    }

    const navbarLinkToggle = document.querySelector(".Navbar_Toggle");
    if (navbarLinkToggle) {
        document.addEventListener("click", classToggle);
    }

    new Swiper('.swiper-container', {
    spaceBetween: 10,
    slidesPerView: 1,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
        },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
        },
    });
</script>
<style>
    .Navbar_Brand {
        padding: 15px 0 5px 0;
    }

    .Navbar_Items {
        display: flex;
        margin: auto;
    }

    .Navbar_Toggle {
        display: none;
        padding: 15px 0 5px 0;
    }

    .Internal_Links {
        align-self: flex-start;
    }

    @media only screen and (max-width: 750px) {
        .Internal_Links {
            display: flex;
            flex-direction: column;
            padding: 0 20px;
        }

        .Navbar_Items,
        nav {
            flex-direction: column;
        }

        .Navbar_Items {
            display: none;
            position: absolute;
            top: 90px;
            width: 100%;
            background-color: white;
            box-shadow: 0 10px 8px rgba(var(--black), 10%);
        }

        .Navbar_ToggleShow {
            display: flex;
            padding: 0 40px;
        }

        .Navbar_Brand {
            align-self: flex-start;
            padding-left: 8px;
        }
        .Navbar_Toggle {
            align-self: flex-end;
            display: initial;
            position: absolute;
            cursor: pointer;
            z-index: 1;
        }
    }
</style>

<style>
    header {
        margin: 0;
        background: white;
        box-shadow: 0 2px 8px rgba(var(--black), 5%);
    }
    h2 {
        margin: 0;
        font-size: 1em;
    }

    h2 a,
    h2 a.active {
        text-decoration: none;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 16px;
        font-family: sans-serif;
    }
    nav a {
        padding: 1em 0.5em;
        color: var(--black);
        border-bottom: 4px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        border-bottom-color: var(--accent);
    }
</style>


