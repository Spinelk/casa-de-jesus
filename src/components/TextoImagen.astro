---
const {
    titulo,
    imagenURL,
    alt,
    fondo = "bg-white",
    texto = "text-gray-800",
    invertir = false,
} = Astro.props;

// Colores
const colorFondo = fondo;
const colorTexto = texto;

// Clases para invertir columnas
const textClasses = invertir ? "sm:order-2" : "";
const imageClasses = invertir ? "sm:order-1" : "";
---

<article
    class={`${colorFondo} ${colorTexto} py-10  font-medium text-lg font-poppins`}
>
    <div class="max-w-6xl mx-auto max-xl:px-6">
        <div class={`grid sm:grid-cols-2 gap-10`}>
            <div class={`flex flex-col justify-center ${textClasses}`}>
                <h2 class="text-4xl font-bold mb-5">{titulo}</h2>
                <p><slot /></p>
            </div>

            <div class={`flex justify-center ${imageClasses}`}>
                <div class="sm:w-[30rem] aspect-[3/2]">
                    <img
                        src={imagenURL}
                        class="object-cover h-full w-full rounded-md"
                        alt={alt}
                    />
                </div>
            </div>
        </div>
    </div>
</article>
