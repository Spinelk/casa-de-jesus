---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");
---

<li
    class="font-poppins border-b-[1px] md:border-0 p-4 md:px-2 xl:px-4 transition-all text-gray-700"
>
    <a
        class="uppercase text-sm font-semibold px-0.5"
        href={href}
        class:list={[className, { active: isActive }]}
        {...props}
    >
        <slot />
    </a>
</li>

<style>
    a.active {
        border-bottom: 3px solid var(--azul-milagro);
    }

    a:hover {
        border-bottom: 3px solid var(--azul-milagro);
    }
</style>
