<nav
    class="bg-white dark:bg-gray-900 fixed w-full z-50 top-0 start-0 font-monserrat shadow-md"
>
    <div id="primerDiv" class="border-b-[1px] border-gray hidden lg:block">
        <div class="max-w-5xl grid grid-cols-4 mx-auto">
            <div
                class="border-s-[1px] border-gray p-2 flex justify-center items-center text-sm"
            >
                {CORREO_CONTACTO}
            </div>
            <div
                class="border-x-[1px] border-gray text-center p-2 font-cinzel text-sm col-span-2 flex justify-center items-center font-semibold"
            >
                <div class="flex justify-center gap-4 lg:gap-2">
                    <div>
                        <div>
                            Por una vida sin drogas <span class="max-lg:hidden">
                                -
                            </span>
                            <a
                                class="hover:underline max-lg:block"
                                href="https://www.radiocorporacion.cl/"
                                target="_blank">Radio Coorporación 97.1 FM</a
                            >
                        </div>
                        <div class="flex flex-row justify-center">
                            <div class="flip">
                                Todos los Domingos de 15 a 16 hrs
                            </div>
                            {
                                enVivo && (
                                    <>
                                        <div class="mx-2">-</div>
                                        <div class="flex gap-2">
                                            <span>EN VIVO</span>

                                            <div class="flex items-center aspect-square w-1">
                                                <>
                                                    <div class="bg-red-600 p-1.5 rounded-full aspect-square w-1 absolute" />
                                                    <div class="bg-red-500 p-1.5 rounded-full aspect-square w-1 animate-ping" />
                                                </>
                                            </div>
                                        </div>
                                    </>
                                )
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div
                class="border-e-[1px] border-gray p-2 flex justify-around items-center text-sm"
            >
                <ul class="flex flex-row gap-4">
                    <li>
                        <IconoFacebook href={ENLACE_FACEBOOK} />
                    </li>

                    <li>
                        <IconoInstagram href={ENLACE_INSTAGRAM} />
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div
        class="max-w-6xl flex flex-wrap items-center justify-between mx-auto max-xl:px-3 py-3"
    >
        <Logotipo retractil="true" />
        <button
            data-collapse-toggle="navbar-default"
            type="button"
            class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-800 dar:text-white rounded-lg lg:hidden focus:outline-none"
            aria-controls="navbar-default"
            aria-expanded="false"
        >
            <span class="sr-only">Abrir menu lateral</span>
            <svg
                class="w-5 h-5"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 17 14"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M1 1h15M1 7h15M1 13h15"></path>
            </svg>
        </button>
        <div class="hidden w-full lg:block lg:w-auto" id="navbar-default">
            <ul
                class="bg-white flex max-lg:flex-col max-lg:absolute top-16 md:top-20 lg:top-0 max-lg:left-0 max-lg:w-full z-40"
            >
                <NavbarLink href="/">Casa de Jesús</NavbarLink>
                <NavbarLink href="/ayuda">¿Necesitas Ayuda?</NavbarLink>
                <NavbarLink href="/esperanza">
                    Esperanza y Renacimiento
                </NavbarLink>
                <NavbarLink href="/contacto">Contacto</NavbarLink>
                <div class="lg:hidden">
                    <NavbarLink href={ENLACE_FACEBOOK} target="_blank">
                        Facebook
                    </NavbarLink>
                </div>
                <div class="lg:hidden">
                    <NavbarLink href={ENLACE_INSTAGRAM} target="_blank">
                        Instagram
                    </NavbarLink>
                </div>
            </ul>
        </div>
    </div>
</nav>
