---
const { titulo, numero } = Astro.props;
---

<div class="relative mb-6 sm:mb-0">
    <div class="flex items-center">
        <div
            class="z-10 flex items-center justify-center w-6 h-6 m-2 bg-blue-100 rounded-full dark:bg-blue-900 shrink-0"
        >
            <span class="font-bold">{numero}</span>
        </div>
        <div class="hidden sm:flex w-full bg-gray-200 h-0.5 dark:bg-gray-700">
        </div>
    </div>
    <div class="mt-3 sm:pe-8">
        <h3 class="text-lg font-semibold">
            {titulo}
        </h3>
        <p class="text-base font-normal text-gray-500 dark:text-gray-400">
            <slot />
        </p>
    </div>
</div>
