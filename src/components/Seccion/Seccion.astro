---
const {
    titulo,
    imagenURL,
    mapaURL,
    alt,
    fondo = "bg-white",
    texto = "text-gray-800",
    tamañoTitulo = "text-4xl",
    tamañoTexto = "text-lg",
    invertir = false,
    vertical = false,
    extra = false,
} = Astro.props;

// Colores
const colorFondo = fondo;
const colorTexto = texto;

// Clases para vertical
const ordenTexto = invertir ? "sm:order-2" : ""; // Clases para invertir columnas

const anchoMaximo = vertical ? "" : "max-w-6xl";
const anchoMaximoVertical = vertical ? "max-w-6xl mx-auto" : "";

const textoCentrado = vertical ? "text-center" : "";

const cantidadColumnas = vertical ? "" : "sm:grid-cols-2";
const tamaño = vertical
    ? "max-w-5xl w-full mx-auto aspect-[3/2] md:aspect-[3/1]"
    : "w-full sm:w-[30rem] aspect-[3/2]";
---

<section
    class={`${colorFondo} ${colorTexto} ${tamañoTexto} py-10  font-medium font-poppins`}
>
    <div class={`${anchoMaximo} mx-auto max-xl:px-6`}>
        <div class={`grid ${cantidadColumnas} gap-10`}>
            <div
                class={`flex flex-col justify-center ${textoCentrado} ${ordenTexto} ${anchoMaximoVertical}`}
            >
                {
                    titulo && (
                        <h2 class={`${tamañoTitulo} font-bold mb-5`}>
                            {titulo}
                        </h2>
                    )
                }
                <slot name="texto" />
            </div>

            {
                imagenURL && (
                    <div class="flex justify-center">
                        <div class={`${tamaño}`}>
                            <img
                                src={imagenURL}
                                class="object-cover h-full w-full rounded-md"
                                alt={alt}
                            />
                        </div>
                    </div>
                )
            }
            {
                mapaURL && (
                    <div class="flex justify-center">
                        <div class={`${tamaño}`}>
                            <div class="w-full h-full relative overflow-hidden iframe-container">
                                <iframe
                                    src={mapaURL}
                                    class="object-cover rounded-md w-full h-full absolute top-0 left-0 border-0"
                                    loading="eager"
                                />
                            </div>
                        </div>
                    </div>
                )
            }
            <!-- extra solo se debe utilizar cuando no haya imagenURL o mapaURL -->
            {
                extra && (
                    <div>
                        <slot name="contenido" />
                    </div>
                )
            }
        </div>
    </div>
</section>
