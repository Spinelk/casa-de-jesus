---
const { titulo, imagenURL, alt } = Astro.props;
---

<div
    class="aspect-[6/5] sm:aspect-[4/5] rounded-md relative overflow-hidden text-white img-hover-zoom"
>
    <img
        src={imagenURL}
        class="w-full h-full object-cover absolute brightness-75"
        alt={alt}
    />
    <div class="absolute p-4 flex flex-col justify-end h-full w-full">
        <h3 class="font-extrabold text-xl">{titulo}</h3>
        <span class="text-gray-200"> <slot /></span>
    </div>
</div>

<style>
    .img-hover-zoom img {
        transition: transform 0.5s ease;
    }

    .img-hover-zoom:hover img {
        transform: scale(1.1);
    }
</style>
