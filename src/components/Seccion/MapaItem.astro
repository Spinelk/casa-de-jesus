---
const { direccion, telefono="xxx" } = Astro.props;
---

<p>
    <slot />
</p>

<p class="font-semibold text-gray-700 text-xl mt-3 leading-5 italic">
    {direccion}
</p>

<p class="font-semibold text-gray-700 text-xl mt-3">
    Telefono: <a href="tel:{telefono}" class="italic hover:underline"
        >+{telefono}</a>
</p>
