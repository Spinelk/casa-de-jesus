<div class="voluntario">
    <div class="flex">
        <div class="w-1/2 bg-cover"></div>
        <div class="w-1/2 m-0 p-0 flex-grow">
            <div class="voluntario-form p-8">
                <form class="max-w-sm mx-auto">
                    <h2>¡Sé voluntario con nosotros!!</h2>
                    <div class="mb-5">
                        <label
                            for="email"
                            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                            >Correo:</label
                        >
                        <input
                            type="email"
                            id="email"
                            class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:shadow-sm-light"
                            placeholder="Correo electrónico"
                            required
                        />
                    </div>
                    <div class="mb-5">
                        <label
                            for="tel"
                            class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
                            >Contacto telefónico:</label
                        >
                        <input
                            type="tel"
                            id="tel"
                            class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 dark:shadow-sm-light"
                            placeholder="(+569...)"
                            required
                        />
                    </div>

                    <button
                        type="submit"
                        class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                        >Enviar</button
                    >
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .voluntario {
        background-image: url(voluntario.jpg);
        background-position: center center;
        background-size: cover;
        background-repeat: no-repeat;
    }

    .voluntario-form {
        background-image: url(fondo01.png);
        background-position: center center;
        background-size: cover;
        text-align: left;
        z-index: 9;
    }
</style>
